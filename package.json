{
  "name": "student-grievance-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Redressal - Full-stack Student Grievance & Review Portal",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/server.js",
